# Copy to .env and fill in. Required for the prod profile; dev needs none of this.

# Active Spring profile (dev is the default when unset)
SPRING_PROFILES_ACTIVE=prod

# JDBC URL of the database, e.g. jdbc:mysql://db-host:3306/suwalink_db?serverTimezone=UTC
DB_URL=
# Database user
DB_USERNAME=
# Database password
DB_PASSWORD=

# JWT signing secret, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# SMTP host used for password reset OTP emails
MAIL_HOST=
# SMTP port (default 587)
MAIL_PORT=587
# SMTP username (optional for unauthenticated relays)
MAIL_USERNAME=
# SMTP password or app password
MAIL_PASSWORD=
# From address on outgoing mail (default no-reply@suwalink.lk)
MAIL_FROM=no-reply@suwalink.lk

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=
# Directory for uploaded images (default uploads)
UPLOAD_DIR=uploads

# Initial admin account, used by the admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
