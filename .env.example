# Copy to .env (git-ignored) and fill in. docker compose picks it up automatically.
# Every value here has a working dev default in docker-compose.yml, so .env is
# only needed when you want to override one.

# Long random string. Change it for anything that isn't local dev.
JWT_SECRET=

# Gmail SMTP, used to send password-reset OTPs.
# App password comes from Google Account > Security > App passwords.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
