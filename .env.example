# SuwaLink production settings for docker-compose.yml.
#   cp .env.example .env    then fill in every blank value. Never commit .env.
# Local development needs none of this (docker-compose.dev.yml + the dev profile).
# Generate secrets with: openssl rand -base64 48

# ---- Site ----------------------------------------------------------------------
# Public address Caddy serves. http://localhost serves plain HTTP. A real domain
# (e.g. suwalink.example.lk, DNS pointing at this server, ports 80/443 open) makes
# Caddy obtain and renew an HTTPS certificate automatically.
# The in-app QR camera needs a secure context, so it works only on localhost or HTTPS;
# typing the code by hand works everywhere.
SITE_ADDRESS=http://localhost
# Host ports for Caddy. Rootless podman cannot bind below 1024 without
# sysctl net.ipv4.ip_unprivileged_port_start=80; use e.g. 8080/8443 there instead.
HTTP_PORT=80
HTTPS_PORT=443

# ---- Database (MySQL container) -------------------------------------------------
# Applied only when the db_data volume is first created; changing them later does
# not change the existing database.
MYSQL_DATABASE=suwalink_db
MYSQL_USER=suwalink_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---- Security -------------------------------------------------------------------
# JWT signing secret, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# ---- Admin ----------------------------------------------------------------------
# Initial admin, created on first start only if no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional display name (default "SuwaLink Admin")
ADMIN_NAME=SuwaLink Admin

# ---- Mail (password reset codes, notifications) --------------------------------
# SMTP relay host and port (587 = STARTTLS submission)
MAIL_HOST=
MAIL_PORT=587
# SMTP login (leave blank for an unauthenticated relay)
MAIL_USERNAME=
MAIL_PASSWORD=
# true/true for a real relay; false/false for Mailpit
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# From address on outgoing mail
MAIL_FROM=no-reply@suwalink.lk
# Demo users never get real mail: it goes to this address instead, or nowhere when blank
DEMO_MAIL_REDIRECT=

# ---- Demo -----------------------------------------------------------------------
# Seed the demo pharmacies, customers and stock on startup when missing. They stay
# hidden until an admin turns demo mode on.
DEMO_SEED_ENABLED=true

# ---- Backups (scripts/backup.sh) --------------------------------------------------
# Where backups are written, and how many days of them to keep
BACKUP_DIR=/var/backups/suwalink
BACKUP_KEEP_DAYS=14

# ---- Showcase on localhost ----------------------------------------------------------
# To catch all mail in Mailpit instead of a real relay, set:
#   MAIL_HOST=mailpit
#   MAIL_PORT=1025
#   MAIL_SMTP_AUTH=false
#   MAIL_SMTP_STARTTLS=false
# and start with: docker compose --profile demo up -d --build
# The Mailpit inbox is then at http://127.0.0.1:8025 (MAILPIT_UI_PORT changes the port).

# ---- Derived by docker-compose.yml ------------------------------------------------------
# The backend also reads these. Compose sets them from the values above; set them
# yourself only when running the backend jar without compose. CORS_ALLOWED_ORIGINS and
# FRONTEND_BASE_URL may also be set here to override the compose default.
#   DB_URL                jdbc:mysql://HOST:3306/DB?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
#   DB_USERNAME           database user
#   DB_PASSWORD           database password
#   UPLOAD_DIR            uploaded images directory (image default /app/uploads, a volume)
#   CORS_ALLOWED_ORIGINS  allowed browser origins (compose default: SITE_ADDRESS)
#   FRONTEND_BASE_URL     base URL for links in emails (compose default: SITE_ADDRESS)
#   SPRING_PROFILES_ACTIVE  prod (the image default)
#   ENV_FILE              (compose only) env file handed to the backend, default .env;
#                         lets an isolated test stack use e.g. .env.prodtest
